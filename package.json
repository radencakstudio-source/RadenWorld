{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite --host 0.0.0.0",
        "game-server": "node --watch-path=server server/game-server.js",
        "tunnel": "ngrok http 3001",
        "dev:all": "concurrently -n \"LARAVEL,VITE,SERVER\" -c \"red,cyan,green\" \"php artisan serve --host=0.0.0.0 --port=8000\" \"vite --host 0.0.0.0\" \"node --watch-path=server server/game-server.js\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@babel/parser": "^7.29.9",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.1.4",
        "lucide-react": "^1.52.0",
        "phaser": "^4.2.1",
        "pixi.js": "^8.22.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "typescript": "^7.0.2"
    }
}
